# ==============================================================================
# проект «так называемый SPARK» — Environment Variables Example
# Скопируйте этот файл в .env и подставьте реальные значения:
# cp .env.example .env
# ==============================================================================

# --- Основные настройки домена и портов ---
DOMAIN=so-called-spark.ru
PORT_HTTP=80
PORT_BACKEND=38088
PORT_FRONTEND=38300
PORT_POSTGRES=38543
TIMEZONE=Europe/Moscow

# --- База данных PostgreSQL ---
POSTGRES_USER=spark_user
POSTGRES_PASSWORD=StrongPassword2026
POSTGRES_DB=spark_db

# --- Учётные данные администратора (Панель управления /admin) ---
# Вход в админ-панель: https://so-called-spark.ru/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SparkAdmin2026!
# Telegram ID администратора (числовой ID для получения чеков и уведомлений, узнать в @userinfobot):
ADMIN_TELEGRAM_ID=123456789

# --- Telegram Bot & Авторизация ---
# Токен бота от @BotFather (spark_prep_bot):
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
NEXT_PUBLIC_BOT_USERNAME=spark_prep_bot

# Канал проекта (для автоматической выдачи одноразовых ссылок):
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_INVITE_LINK=https://t.me/+so_called_spark_private

# Секретный ключ для подписи JWT-сессий (рекомендуется сгенерировать: openssl rand -hex 32):
JWT_SECRET=super-secret-spark-jwt-key-2027

# --- Резервное копирование БД (PostgreSQL Backups) ---
# Если указаны, бэкап будет дополнительно отправляться в Telegram:
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
