# ==============================================================================
# проект «так называемый SPARK» — Production Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=spark_user
POSTGRES_PASSWORD=StrongPassword2026!
POSTGRES_DB=spark_db
DATABASE_URL=postgres://spark_user:StrongPassword2026!@postgres:5432/spark_db?sslmode=disable

# Go Backend Configuration
PORT=8080
DOMAIN=so-called-spark.ru
JWT_SECRET=generate-a-strong-random-64-char-jwt-secret-key-here-2027

# Telegram Bot Integration
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Optional reverse proxy (e.g. Cloudflare Worker) to bypass RKN/TSP blocks on Russian VPS
TELEGRAM_API_SERVER=https://bold-water-3c34.ugolpatyj.workers.dev
# Private Channel / Community Invite Link
TELEGRAM_INVITE_LINK=https://t.me/+your_private_channel_invite_link
# Lead Curator / Admin Credentials
ADMIN_TELEGRAM_ID=123456789
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SparkAdmin2026!

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://so-called-spark.ru/api/v1
NEXT_PUBLIC_BOT_USERNAME=spark_prep_bot

# n8n Automation Engine
WEBHOOK_URL=https://n8n.so-called-spark.ru/
TIMEZONE=Europe/Moscow
N8N_SECURE_COOKIE=false
N8N_PROTOCOL=http
N8N_TRUST_PROXY=true
N8N_PROXY_HOPS=1

# ==============================================================================
# Custom Unique Ports (Avoids port conflicts on existing servers)
# ==============================================================================
# Caddy Web Reverse Proxy (Change to 80/443 if standard ports are free)
PORT_HTTP=38080
PORT_HTTPS=38443

# n8n Visual Automation UI
PORT_N8N=38567

# Direct internal access (bound to localhost 127.0.0.1 for security)
PORT_FRONTEND=127.0.0.1:38300
PORT_BACKEND=127.0.0.1:38088
PORT_POSTGRES=127.0.0.1:38543
