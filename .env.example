# ==============================================================================
# проект «так называемый SPARK» — Environment Variables Example
# ==============================================================================
# Скопируйте этот файл в .env и заполните ВСЕ обязательные значения.
# Значения ниже намеренно пустые: приложение в production не запустится,
# пока не заданы сильные уникальные секреты (fail-closed проверка в config.Validate).
#   cp .env.example .env
#   openssl rand -hex 32   # для JWT_SECRET / TELEGRAM_WEBHOOK_SECRET
# ==============================================================================

# production | development
ENV=production

# --- Основные настройки домена и портов ---
DOMAIN=so-called-spark.ru
PORT_HTTP=80
PORT_BACKEND=38088
PORT_FRONTEND=38300
PORT_POSTGRES=38543
TIMEZONE=Europe/Moscow

# --- База данных PostgreSQL ---
POSTGRES_USER=spark_user
POSTGRES_PASSWORD=
POSTGRES_DB=spark_db

# --- Учётные данные администратора (Панель управления /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Base32-секрет TOTP для 2FA (необязательно, но рекомендуется в production):
ADMIN_TOTP_SECRET=
# Telegram ID администратора (числовой ID для получения чеков и уведомлений):
ADMIN_TELEGRAM_ID=

# --- Telegram Bot & Авторизация ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_BOT_USERNAME=spark_prep_bot
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (обязателен в production):
TELEGRAM_WEBHOOK_SECRET=

# Канал проекта (для автоматической выдачи одноразовых ссылок):
TELEGRAM_CHANNEL_ID=
TELEGRAM_INVITE_LINK=

# Секретный ключ для подписи JWT-сессий (минимум 32 символа, уникальный):
JWT_SECRET=

# Доверенные reverse-proxy, которым разрешено передавать X-Forwarded-For.
# Не добавляйте сюда публичные адреса клиентов.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Срок хранения analytics_events и experiment_assignments (дни):
ANALYTICS_RETENTION_DAYS=180

# Sentry DSN для ошибок backend и client-errors (необязательно):
SENTRY_DSN=

# Постоянная ссылка на Zoom для созвонов с куратором (VIP / Акселератор):
ZOOM_MEETING_URL=

# --- Платёжные шлюзы ---
# Требуется хотя бы один полностью настроенный провайдер.
# ЮKassa (ООО НКО «ЮМани» / Сбер):
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Tribute (@tribute / Telegram Payments):
TRIBUTE_API_KEY=

# Antilopay:
ANTILOPAY_PUBLIC_KEY=
ANTILOPAY_SECRET_ID=

# Enot.io (legacy, не обязателен):
ENOT_SHOP_ID=
ENOT_SECRET_KEY=

# --- Резервное копирование БД (PostgreSQL Backups) ---
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
