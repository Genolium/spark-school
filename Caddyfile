# Caddyfile for проект «так называемый SPARK» (Reverse-Proxied Mode)

{
    admin off
    auto_https off
}

# Handles both direct IP queries and reverse-proxied domain traffic from host Nginx
http://so-called-spark.ru, http://www.so-called-spark.ru, http://sparkprep.ru, :80 {
    # Block suspicious scanner queries, hidden files, and exploit probes
    @blocked {
        path *.env* *.git* /wp-* /phpmyadmin* *.sql /xmlrpc.php /admin.php /.aws*
    }
    respond @blocked "Access Denied" 403

    # Limit request payload size to 5MB
    request_body {
        max_size 5MB
    }

    # Reverse proxy API requests to Go Backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # All frontend pages and static files served by Next.js
    handle {
        reverse_proxy frontend:3000
    }

    encode zstd gzip

    # Static asset caching (Next.js immutable chunks & fonts)
    @static {
        path /_next/static/* /fonts/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Static media assets caching
    @media {
        path *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff2 *.ttf
    }
    header @media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

    # Modern Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Cross-Origin-Resource-Policy "same-site"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://telegram.org https://yookassa.ru https://*.yookassa.ru; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://telegram.org https://oauth.telegram.org https://yookassa.ru https://*.yookassa.ru; frame-ancestors 'self'; form-action 'self' https://yookassa.ru https://*.yookassa.ru; connect-src 'self' https://so-called-spark.ru https://*.so-called-spark.ru https://api.yookassa.ru https://yookassa.ru https://api.telegram.org"
        -Server
    }
}
